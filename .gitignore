# OceanEmbed — Comprehensive .gitignore

# =============================================================
# RAW DATA — Never committed (18+ GB, fetched via src/01_fetch_data.py)
# =============================================================
data/raw/
data/raw/*

# Intermediate processed cube (pre-climatology, reproducible)
data/processed/oceanembed_cube.nc
data/processed/.DS_Store

# Sanity check image in data/processed (generated by src/04_sanity_check.py)
# data/processed/sanity_check.png  <- KEEP: small, useful QA artifact

# =============================================================
# EXPORTS — EXCLUDED LARGE ARTIFACTS (too large or reproducible)
# =============================================================
# regime_profile_level.csv: 89 MB intermediate audit artifact
exports/regime_profile_level.csv

# residual_correction_head.keras: experimental, not used in production inference
exports/residual_correction_head.keras

# Intermediate missingness audit files (reproducible from source data)
# exports/missingness_cell_audit_argo.csv  <- LFS tracked, keep
# exports/all_scientific_nulls_ledger.csv  <- LFS tracked, keep

# =============================================================
# SCRATCH / DEVELOPMENT FILES — Never committed
# =============================================================
OceanEmbed_MASTER.md
test_out.txt
train_candidate.log

# =============================================================
# LOCAL ENVIRONMENTS
# =============================================================
.venv/
venv/
env/
.env
.envrc

# =============================================================
# PYTHON ARTIFACTS
# =============================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
*.manifest
*.spec

# =============================================================
# JUPYTER
# =============================================================
.ipynb_checkpoints/
*.ipynb_checkpoints

# =============================================================
# KERAS / ML LOCAL CACHES
# =============================================================
.keras/
*.matplotlib_cache/
.matplotlib_cache/
lightning_logs/
mlruns/

# =============================================================
# macOS
# =============================================================
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# =============================================================
# CREDENTIALS — NEVER COMMITTED
# =============================================================
.netrc
.copernicusmarine/
.earthdata*
credentials.json
secrets.json
*.pem
*.key
*.env
*.token
.aiven*
supabase_key*
CMEMS_*
EARTHDATA_*
API_KEY*

# =============================================================
# IDE
# =============================================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.spyderproject
.ropeproject

# =============================================================
# LOGS AND TEMP
# =============================================================
*.log
*.tmp
*.temp
nohup.out
*.out

# =============================================================
# LARGE BINARIES NOT IN LFS (handled by .gitattributes instead)
# =============================================================
# Note: .keras, .nc, .csv, .parquet files tracked by LFS are
# listed in .gitattributes. DO NOT add them here or they will
# be excluded from LFS tracking.
